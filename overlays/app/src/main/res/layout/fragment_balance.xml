<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/balance_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_18">

        <LinearLayout
            android:id="@+id/placeholder_balance"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginTop="@dimen/space_8"
            android:layout_marginEnd="@dimen/space_16"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_24">

            <ImageView
                android:layout_width="@dimen/placeholder_illustration_size"
                android:layout_height="@dimen/placeholder_illustration_size"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_battery_4_bar_24"
                app:tint="@color/icon_default" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="@dimen/space_18"
                android:text="@string/balance_title"
                android:textAppearance="@style/TextAppearance.OpenJbd.EmptyTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="@dimen/space_6"
                android:text="@string/empty_cells"
                android:textAppearance="@style/TextAppearance.OpenJbd.EmptyBody" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/content_balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_16"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/space_16"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                style="@style/OpenJbdMaterialCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_14">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/param_cell_count"
                        android:textAppearance="@style/TextAppearance.OpenJbd.MetricLabel" />

                    <TextView
                        android:id="@+id/txt_balance_cell_count"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/space_4"
                        android:text="@string/placeholder_value"
                        android:textAppearance="@style/TextAppearance.OpenJbd.MetricValue" />

                    <TextView
                        android:id="@+id/txt_balance_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="@dimen/space_8"
                        android:text="@string/balance_none"
                        android:textAppearance="@style/TextAppearance.OpenJbd.StatusValue" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/balance_stats_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_8"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/OpenJbdMaterialCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_4"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_14">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/cell_min_voltage"
                                android:textAppearance="@style/TextAppearance.OpenJbd.MetricLabel" />

                            <TextView
                                android:id="@+id/txt_balance_cell_min"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="@dimen/space_6"
                                android:text="@string/placeholder_value"
                                android:textAppearance="@style/TextAppearance.OpenJbd.MetricValue" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/OpenJbdMaterialCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_14">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/cell_max_voltage"
                                android:textAppearance="@style/TextAppearance.OpenJbd.MetricLabel" />

                            <TextView
                                android:id="@+id/txt_balance_cell_max"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="@dimen/space_6"
                                android:text="@string/placeholder_value"
                                android:textAppearance="@style/TextAppearance.OpenJbd.MetricValue" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_8"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/OpenJbdMaterialCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/space_4"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_14">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/cell_average_voltage"
                                android:textAppearance="@style/TextAppearance.OpenJbd.MetricLabel" />

                            <TextView
                                android:id="@+id/txt_balance_cell_average"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="@dimen/space_6"
                                android:text="@string/placeholder_value"
                                android:textAppearance="@style/TextAppearance.OpenJbd.MetricValue" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        style="@style/OpenJbdMaterialCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_4"
                        android:layout_weight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_14">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/cell_delta_voltage"
                                android:textAppearance="@style/TextAppearance.OpenJbd.MetricLabel" />

                            <TextView
                                android:id="@+id/txt_balance_cell_delta"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingTop="@dimen/space_6"
                                android:text="@string/placeholder_value"
                                android:textAppearance="@style/TextAppearance.OpenJbd.MetricValue" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/OpenJbdSectionTitle"
                android:text="@string/cell_voltages_title" />

            <LinearLayout
                android:id="@+id/list_balance_cells"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
