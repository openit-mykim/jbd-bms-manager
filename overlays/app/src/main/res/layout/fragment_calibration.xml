<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/calibration_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/calibration_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/top_app_bar_height"
        app:navigationContentDescription="@string/settings_close"
        app:navigationIcon="@drawable/ic_close_24"
        app:title="@string/control_section_calibration"
        app:titleTextColor="?attr/colorOnPrimary">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calibration_refresh_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/settings_refresh"
            android:textAllCaps="false"
            android:textColor="?attr/colorOnPrimary" />
    </com.google.android.material.appbar.MaterialToolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12"
            android:paddingBottom="@dimen/space_24">

            <TextView
                android:id="@+id/calibration_access_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_16"
                android:textAppearance="@style/TextAppearance.OpenJbd.ListItemTitle" />

            <TextView
                android:id="@+id/calibration_last_updated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.OpenJbd.ListItemSubtitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@color/surface_elevation_2"
                android:padding="@dimen/space_12"
                android:text="@string/calibration_intro"
                android:textAppearance="@style/TextAppearance.OpenJbd.EmptyBody" />

            <LinearLayout
                android:id="@+id/calibration_progress_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_4"
                android:visibility="gone">

                <ProgressBar
                    android:layout_width="@dimen/icon_size_24"
                    android:layout_height="@dimen/icon_size_24"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/calibration_progress_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.OpenJbd.EmptyBody" />
            </LinearLayout>

            <TextView
                android:id="@+id/calibration_read_only_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@color/surface_elevation_2"
                android:padding="@dimen/space_12"
                android:textAppearance="@style/TextAppearance.OpenJbd.EmptyBody"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/calibration_read_issues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_8"
                android:visibility="gone" />

            <TextView
                style="@style/OpenJbdSectionTitle"
                android:text="@string/calibration_subgroup_current" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/calibration_current_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_card_stroke"
                    android:orientation="vertical"
                    android:showDividers="middle" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/OpenJbdSectionTitle"
                android:text="@string/calibration_subgroup_cells" />

            <TextView
                android:id="@+id/calibration_no_cells"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_12"
                android:text="@string/calibration_no_cells"
                android:textAppearance="@style/TextAppearance.OpenJbd.EmptyBody"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/calibration_cells_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/calibration_cells_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_card_stroke"
                    android:orientation="vertical"
                    android:showDividers="middle" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/OpenJbdSectionTitle"
                android:text="@string/calibration_subgroup_ntc" />

            <TextView
                android:id="@+id/calibration_no_ntcs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_12"
                android:text="@string/calibration_no_ntcs"
                android:textAppearance="@style/TextAppearance.OpenJbd.EmptyBody"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/calibration_ntcs_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/calibration_ntcs_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_card_stroke"
                    android:orientation="vertical"
                    android:showDividers="middle" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/calibration_staged_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/OpenJbdSectionTitle"
                    android:text="@string/settings_staged_title" />

                <LinearLayout
                    android:id="@+id/calibration_staged_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/calibration_result_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/OpenJbdSectionTitle"
                    android:text="@string/settings_result_title" />

                <TextView
                    android:id="@+id/calibration_result_outcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.OpenJbd.ListItemTitle" />

                <LinearLayout
                    android:id="@+id/calibration_result_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_8" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_12"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_12"
        android:paddingBottom="@dimen/space_8">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calibration_clear_all_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_clear_all"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/calibration_apply_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:enabled="false"
            android:text="@string/settings_apply"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
