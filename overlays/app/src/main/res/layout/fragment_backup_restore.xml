<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/backup_restore_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/backup_restore_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/top_app_bar_height"
        android:title="@string/control_section_backup_restore"
        android:titleTextColor="?attr/colorOnPrimary"
        app:navigationContentDescription="@string/settings_close"
        app:navigationIcon="@drawable/ic_close_24"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backup_refresh_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/settings_refresh"
            android:textAllCaps="false"
            android:textColor="?attr/colorOnPrimary" />
    </com.google.android.material.appbar.MaterialToolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12"
            android:paddingBottom="@dimen/space_24">

            <TextView
                style="@style/OpenJbdSectionTitle"
                android:text="@string/backup_current_configuration" />

            <TextView
                android:id="@+id/backup_read_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.OpenJbd.ListItemTitle" />

            <TextView
                android:id="@+id/backup_read_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.OpenJbd.ListItemSubtitle" />

            <ProgressBar
                android:id="@+id/backup_progress"
                android:layout_width="@dimen/icon_size_24"
                android:layout_height="@dimen/icon_size_24"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_12"
                android:indeterminate="true"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/backup_issues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_8"
                android:visibility="gone" />

            <TextView
                style="@style/OpenJbdSectionTitle"
                android:text="@string/backup_export_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backup_export_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="@string/backup_export"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/backup_last_exported"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.OpenJbd.ListItemSubtitle" />

            <TextView
                style="@style/OpenJbdSectionTitle"
                android:text="@string/backup_restore_title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backup_import_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/backup_import"
                android:textAllCaps="false" />

            <TextView
                android:id="@+id/backup_loaded_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.OpenJbd.ListItemSubtitle" />

            <LinearLayout
                android:id="@+id/backup_review_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/OpenJbdSectionTitle"
                    android:text="@string/backup_review_title" />

                <LinearLayout
                    android:id="@+id/backup_review_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/backup_result_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/OpenJbdSectionTitle"
                    android:text="@string/settings_result_title" />

                <TextView
                    android:id="@+id/backup_result_outcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.OpenJbd.ListItemTitle" />

                <LinearLayout
                    android:id="@+id/backup_result_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_8" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/backup_apply_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/space_12"
        android:layout_marginBottom="@dimen/space_8"
        android:enabled="false"
        android:text="@string/backup_restore_apply"
        android:textAllCaps="false" />
</LinearLayout>
