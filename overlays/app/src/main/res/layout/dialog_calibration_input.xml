<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_24"
    android:paddingTop="@dimen/space_8"
    android:paddingEnd="@dimen/space_24"
    android:paddingBottom="@dimen/space_8">

    <TextView
        android:id="@+id/calibration_input_guidance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.OpenJbd.ListItemSubtitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_16"
        android:text="@string/calibration_concept_bms"
        android:textAppearance="@style/TextAppearance.OpenJbd.ListItemTitle" />

    <TextView
        android:id="@+id/calibration_input_bms_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_4"
        android:textAppearance="@style/TextAppearance.OpenJbd.ListItemSubtitle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_16"
        android:text="@string/calibration_concept_external"
        android:textAppearance="@style/TextAppearance.OpenJbd.ListItemTitle" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/calibration_input_layout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:hint="@string/calibration_external_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/calibration_input_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:maxLines="1"
            android:selectAllOnFocus="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_16"
        android:text="@string/calibration_concept_operation"
        android:textAppearance="@style/TextAppearance.OpenJbd.ListItemTitle" />

    <TextView
        android:id="@+id/calibration_input_operation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_4"
        android:text="@string/calibration_operation_waiting"
        android:textAppearance="@style/TextAppearance.OpenJbd.ListItemSubtitle" />

    <TextView
        android:id="@+id/calibration_input_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/space_8"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Caption" />
</LinearLayout>
