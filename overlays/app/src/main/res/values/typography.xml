<?xml version="1.0" encoding="utf-8"?>
<!--
  Mobile dev standard 5.7.2: the only text sizes allowed on screen.
  Display 28 / Title 22 / Heading 18 / Body 16 / Label 14 / Caption 12 / Micro 11 (sp).
  Material defaults outside this list (Headline3 48, Headline5 24, Headline6 20) are
  overridden in styles by scripts/apply-product-overlay.py. Documented exception: the
  landscape dashboard's large numerals (docs/mobile-standard-compliance.md).
-->
<resources>
    <dimen name="text_display">28sp</dimen>
    <dimen name="text_title">22sp</dimen>
    <dimen name="text_heading">18sp</dimen>
    <dimen name="text_body">16sp</dimen>
    <dimen name="text_label">14sp</dimen>
    <dimen name="text_caption">12sp</dimen>
    <dimen name="text_micro">11sp</dimen>
</resources>
